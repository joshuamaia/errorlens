# ---------------------------------------------------------------------------
# ErrorLens - variáveis de ambiente do laboratório local
# Copie para .env e ajuste se necessário:  cp .env.example .env
# ATENÇÃO: valores apenas para LABORATÓRIO LOCAL. Nunca reutilize em produção.
# ---------------------------------------------------------------------------

# Portas publicadas no host
FRONTEND_PORT=4200
BACKEND_PORT=8080
JAEGER_UI_PORT=16686

# PostgreSQL (rede interna do Compose; porta não publicada)
POSTGRES_DB=errorlens
POSTGRES_USER=errorlens
POSTGRES_PASSWORD=errorlens-lab-db

# Identidades locais de demonstração (Spring Security, senhas com BCrypt em memória)
ERRORLENS_ADMIN_PASSWORD=errorlens
ERRORLENS_ANALYST_PASSWORD=analyst-lab
ERRORLENS_VIEWER_PASSWORD=viewer-lab
ERRORLENS_AUDITOR_PASSWORD=auditor-lab
ERRORLENS_RUNNER_PASSWORD=runner-lab

# Token compartilhado entre backend e dependency-simulator para endpoints de controle
SIMULATOR_CONTROL_TOKEN=lab-control-token

# Retenção do histórico de execuções (dias)
ERRORLENS_RETENTION_DAYS=30

# URL pública do Jaeger (usada pelo frontend para links de traces)
JAEGER_PUBLIC_URL=http://localhost:16686
